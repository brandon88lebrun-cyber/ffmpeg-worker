CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
# Same value as the app's FFMPEG_WORKER_SECRET. /jobs is disabled while unset.
WORKER_SECRET=
# Optional. Default: capsulated.app,www.capsulated.app
# ALLOWED_CALLBACK_HOSTS=capsulated.app,www.capsulated.app,localhost
# PORT=3001
# /life-story-jobs only. The route is disabled while unset. Optional model overrides below
# (defaults: claude-opus-5 for both; the verifier falls back to the book model).
ANTHROPIC_API_KEY=
# ANTHROPIC_BOOK_MODEL=claude-opus-5
# ANTHROPIC_BOOK_VERIFIER_MODEL=claude-opus-5
